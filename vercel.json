{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/status",
      "destination": "/api/status"
    },
    {
      "source": "/api/redirect",
      "destination": "/api/redirect"
    },
    {
      "source": "/direct",
      "destination": "/api/redirect"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
